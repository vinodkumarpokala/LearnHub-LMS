[Unit]
Description=LearnHub LMS Flask application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/simple-lms
Environment="SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE"
Environment="LMS_DB_PATH=/var/lib/simple-lms/lms.db"
ExecStart=/opt/simple-lms/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
